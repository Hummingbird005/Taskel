# VBA modules must keep Windows (CRLF) line endings, also when downloaded straight from GitHub,
# or the Outlook VBA editor imports them as a single line. Store them exactly as committed.
*.bas -text

# The offline packages are used byte for byte: npm checks every cache entry against its hash, so a line
# ending changed by git on Windows would make the cache unusable.
offline/nuget/** -text -diff
offline/npm/** -text -diff

# Shell scripts keep Unix line endings, so they run in Git Bash on Windows too.
*.sh text eol=lf

# Pasted into the Outlook VBA editor; kept with Windows line endings like the module.
integrations/outlook/*.txt -text
