<?xml version="1.0" encoding="utf-8"?>
<!--
  Restores Taskel's .NET packages from offline/nuget only, without the internet.
  Pass this file to "dotnet restore" and "dotnet tool restore" with the configfile option;
  the commands are in offline/README.md.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="taskel-offline" value="nuget" />
  </packageSources>
  <!-- No vulnerability data comes from a local folder; the CI job "dependencies" checks it online. -->
  <config>
    <add key="auditSources" value="" />
  </config>
</configuration>
