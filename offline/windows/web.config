<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for Taskel on Windows. Copy it to the site folder (C:\Taskel\www by default), next to
  index.html, and replace the values marked CHANGE. The installation guide (docs/manuale) explains each step.

  IIS serves the interface (the files in this folder). Requests under /api go to the ASP.NET Core Module,
  which starts the API from C:\Taskel\api as a separate process and forwards them to it.
  Needs the ASP.NET Core 10 Hosting Bundle, installed after IIS.

  IIS never serves web.config itself, but this file holds the database password: keep the folder readable
  only by administrators and the application pool.
-->
<configuration>
  <system.webServer>

    <!-- The API process. Used only by the /api handler below. -->
    <aspNetCore processPath="C:\Taskel\api\Taskel.Api.exe"
                arguments=""
                hostingModel="outofprocess"
                startupTimeLimit="120"
                requestTimeout="00:10:00"
                stdoutLogEnabled="false"
                stdoutLogFile="C:\TaskelData\logs\stdout">
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        <!-- The API reads its files (appsettings.json) from its own folder, not from this one. -->
        <environmentVariable name="ASPNETCORE_CONTENTROOT" value="C:\Taskel\api" />

        <!-- CHANGE: the database password. -->
        <environmentVariable name="ConnectionStrings__Taskel" value="Host=localhost;Database=taskel;Username=taskel;Password=CHANGE-ME" />
        <environmentVariable name="Database__MigrateOnStartup" value="true" />

        <!-- CHANGE: the first administrator's email. -->
        <environmentVariable name="Auth__AdminEmails__0" value="admin@firma.ro" />
        <!-- Once the accounts you need exist, stop open registration: -->
        <!-- <environmentVariable name="Auth__AllowLocalRegistration" value="false" /> -->

        <environmentVariable name="Attachments__Path" value="C:\TaskelData\attachments" />
        <!-- CHANGE: the address people open Taskel at. -->
        <environmentVariable name="Email__Notifications__PublicUrl" value="https://taskel.firma.ro" />
      </environmentVariables>
    </aspNetCore>

    <security>
      <requestFiltering>
        <!-- Largest request IIS lets through, in bytes: 110 MB, above the default 100 MB attachment limit.
             Raise it with the limit set in Taskel. IIS refuses anything over 30 MB by default. -->
        <requestLimits maxAllowedContentLength="115343360" />
      </requestFiltering>
    </security>

    <staticContent>
      <!-- The interface's fonts. Removed first so the setting works whether or not IIS already knows the type. -->
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

  </system.webServer>

  <!-- Everything under /api goes to the API, and nothing else does. -->
  <location path="api">
    <system.webServer>
      <handlers>
        <clear />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
    </system.webServer>
  </location>
</configuration>
